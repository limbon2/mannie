# Baseline editor settings. The language formatters (rustfmt, Prettier,
# buf format) remain the source of truth for layout.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
