# Baseline editor settings. The language formatters (rustfmt, Prettier,
# buf format) remain the source of truth for layout.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.sse]
# Server-sent event streams are test fixtures whose bytes matter, CRLF line
# endings included.
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false

[crates/mannie-provider/tests/fixtures/**]
# Provider fixtures are byte-for-byte copies of what servers sent (V8).
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
