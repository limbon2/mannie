# Dependencies and build output.
node_modules/
target/
build/
dist/
.svelte-kit/

# Generated sources are never committed (docs/engineering/repository.md).
# `task gen` writes the launcher, its lock and the editor workspace into
# .generated/ (ADR-0035, decision 3).
.generated/
apps/desktop/src/lib/generated/
plugins/*/ui/generated/
tests/fixtures/plugins/*/ui/generated/
apps/desktop/src/lib/paraglide/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/permissions/autogenerated/
apps/desktop/.pseudo-locale/
apps/desktop/.generated/

# The inlang project keeps only its settings and the Paraglide options; its
# cache and working files are inlang's own and ignored here for every tool.
apps/desktop/project.inlang/*
!apps/desktop/project.inlang/settings.json
!apps/desktop/project.inlang/paraglide.config.js

# SBOMs that cargo-cyclonedx writes beside each crate; releases attach them.
*.cdx.json

# Local environment.
.env
.env.*
*.log

# Coding agents: worktrees are other checkouts, and local settings are personal.
.claude/worktrees/
.claude/settings.local.json

# Operating system files.
Thumbs.db
.DS_Store
