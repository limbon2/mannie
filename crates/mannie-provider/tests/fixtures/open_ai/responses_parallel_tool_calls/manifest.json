{
  "server": "open_ai",
  "interface": "responses",
  "provenance": "constructed",
  "sources": [
    "https://developers.openai.com/api/docs/guides/function-calling",
    "https://developers.openai.com/api/reference/responses/streaming"
  ],
  "verifiedOn": "2026-10-14",
  "request": {
    "model": "gpt-5-mini",
    "instructions": "",
    "messages": [
      {
        "role": "user",
        "text": "Read notes.txt and list the folder."
      }
    ],
    "maxOutputTokens": 1024,
    "reasoningEffort": "server_default",
    "tools": [
      {
        "name": "read_file",
        "description": "Reads lines of a text file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "The file."
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "list_directory",
        "description": "Lists the entries of a folder.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ],
              "description": "The folder."
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    ],
    "toolChoice": "auto"
  }
}
