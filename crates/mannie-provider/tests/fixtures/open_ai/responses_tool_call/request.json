{
  "model": "gpt-5-mini",
  "input": [
    {
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "What does notes.txt say?"
        }
      ]
    }
  ],
  "stream": true,
  "store": false,
  "max_output_tokens": 1024,
  "tools": [
    {
      "type": "function",
      "name": "read_file",
      "description": "Reads lines of a text file.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The file."
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "strict": true
    }
  ],
  "tool_choice": "auto"
}
