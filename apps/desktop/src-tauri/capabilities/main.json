{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main window may call: Mannie's own commands and nothing else. Every app command needs a grant here (ADR-0004).",
  "windows": ["main"],
  "permissions": [
    "allow-answer-close-question",
    "allow-check-link",
    "allow-compact-conversation",
    "allow-confirm-quit",
    "allow-create-provider-profile",
    "allow-delete-conversation",
    "allow-delete-provider-profile",
    "allow-dismiss-window-request",
    "allow-get-chat-settings",
    "allow-get-checkpoint",
    "allow-get-interface-settings",
    "allow-get-model-defaults",
    "allow-get-startup-status",
    "allow-get-window-settings",
    "allow-list-provider-profiles",
    "allow-load-earlier-turns",
    "allow-open-link",
    "allow-rename-conversation",
    "allow-retry-reply",
    "allow-send-message",
    "allow-set-conversation-profile",
    "allow-set-default-provider-profile",
    "allow-set-tray-labels",
    "allow-start-conversation",
    "allow-stop-reply",
    "allow-subscribe-conversation",
    "allow-subscribe-conversations",
    "allow-subscribe-window-requests",
    "allow-test-provider-profile",
    "allow-unsubscribe",
    "allow-update-chat-settings",
    "allow-update-interface-settings",
    "allow-update-provider-profile",
    "allow-update-window-settings"
  ]
}
