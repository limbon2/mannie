{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main window may call: Mannie's own commands and nothing else. Every app command needs a grant here (ADR-0004); the build script writes the grants of the plugins' commands (ADR-0034, decision 8).",
  "windows": ["main"],
  "permissions": [
    "allow-add-project",
    "allow-add-project-from-path",
    "allow-answer-close-question",
    "allow-check-link",
    "allow-compact-conversation",
    "allow-confirm-quit",
    "allow-create-provider-profile",
    "allow-decide-approval",
    "allow-delete-command-rule",
    "allow-delete-conversation",
    "allow-delete-provider-profile",
    "allow-dismiss-window-request",
    "allow-get-chat-settings",
    "allow-get-checkpoint",
    "allow-get-child-agents-settings",
    "allow-get-interface-settings",
    "allow-get-model-defaults",
    "allow-get-startup-status",
    "allow-get-tools-settings",
    "allow-get-window-settings",
    "allow-list-command-rules",
    "allow-list-conversation-grants",
    "allow-list-provider-profiles",
    "allow-list-shared-grants",
    "allow-load-earlier-turns",
    "allow-open-link",
    "allow-plugin-work",
    "allow-read-image",
    "allow-read-tool-output",
    "allow-remove-project",
    "allow-rename-conversation",
    "allow-rename-project",
    "allow-retry-reply",
    "allow-revoke-conversation-grant",
    "allow-revoke-shared-grant",
    "allow-send-message",
    "allow-set-conversation-profile",
    "allow-set-default-provider-profile",
    "allow-set-full-access",
    "allow-set-plugin-enabled",
    "allow-set-tray-labels",
    "allow-start-conversation",
    "allow-stop-reply",
    "allow-subscribe-conversation",
    "allow-subscribe-conversations",
    "allow-subscribe-plugins",
    "allow-subscribe-window-requests",
    "allow-suggest-mentions",
    "allow-test-provider-profile",
    "allow-unsubscribe",
    "allow-update-chat-settings",
    "allow-update-child-agents-settings",
    "allow-update-interface-settings",
    "allow-update-provider-profile",
    "allow-update-tools-settings",
    "allow-update-window-settings"
  ]
}
