    "allow-delete-program-rule",
    "allow-delete-provider-profile",
    "allow-delete-remote-command-rule",
    "allow-delete-search-profile",
    "allow-delete-terminal-command-rule",
    "allow-detach-context",
    "allow-dismiss-window-request",
    "allow-export-conversation",
    "allow-get-chat-settings",
