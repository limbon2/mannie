{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mannie",
  "identifier": "io.github.limbon2.mannie",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Mannie",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 480,
        "center": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob:",
        "connect-src": "ipc: https://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'"
      },
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false
      },
      "pattern": {
        "use": "brownfield"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm"],
    "category": "Productivity",
    "shortDescription": "A desktop AI agent harness",
    "longDescription": "Mannie chats with AI models, runs tools on the owner's machine under approvals, and spreads work across machines through workers.",
    "license": "Apache-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["libappindicator-gtk3"]
      }
    }
  }
}
